# ==============================================================================
# ResearchLens - Environment Configuration Template
# Copy this file to .env and configure with your credentials.
# ==============================================================================

# Application Settings
APP_NAME=ResearchLens
APP_ENV=development
DEBUG=true
PORT=8000
FRONTEND_PORT=3000
SECRET_KEY=change-me-to-a-super-secure-random-secret-key-at-least-32-chars
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (PostgreSQL + pgvector)
# Direct connection string or Supabase Postgres connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/researchlens
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=researchlens
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Supabase Auth & Storage (Optional if using local standalone auth/storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
STORAGE_BUCKET=research-papers
STORAGE_LOCAL_PATH=./storage/uploads

# Embedding Model Configuration
# Supported providers: sentence-transformers (local), openai, cohere
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# Reranker Configuration
RERANKER_ENABLED=true
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# LLM Providers Configuration
# Supported providers: openai, anthropic, google, groq, local
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# Provider API Keys (configure the one you use)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AIzaSy...
GROQ_API_KEY=gsk_...

# Retrieval & Hybrid Search Hyperparameters
TOP_K_CHUNKS=10
HYBRID_RETRIEVAL_ALPHA=0.6
RRF_K=60
RERANK_TOP_N=5
SIMILARITY_THRESHOLD=0.45
MAX_CONTEXT_TOKENS=3500

# Document Processing & Ingestion
MAX_FILE_SIZE_MB=35
ALLOWED_FILE_TYPES=application/pdf
CHUNK_SIZE=500
CHUNK_OVERLAP=80
PRESERVE_EQUATIONS=true
EXTRACT_TABLES=true

# Security & Rate Limiting
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
RATE_LIMIT_PER_MINUTE=60
PROMPT_INJECTION_SHIELD=true

# Next.js Frontend Configuration
NEXT_PUBLIC_APP_NAME=ResearchLens
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
