# ==============================================================================
# ResearchLens: Environment Configuration Template
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="ResearchLens"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL with pgvector or SQLite fallback)
# Production PostgreSQL example:
# DATABASE_URL=postgresql+psycopg2://researchlens:password@localhost:5432/researchlens
DATABASE_URL=sqlite:///./researchlens.db

# Security & Authentication
JWT_SECRET=replace-with-a-secure-random-64-character-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Supabase Integration (Optional - falls back to local JWT auth and local storage)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=research-papers

# Document Storage (Local fallback)
LOCAL_STORAGE_DIR=./storage/papers

# LLM & Embedding Providers (Optional - falls back to offline deterministic embeddings)
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Retrieval Hyperparameters
HYBRID_ALPHA=0.7
TOP_K_CHUNKS=5
RERANKING_ENABLED=True

# Frontend URL & CORS
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
